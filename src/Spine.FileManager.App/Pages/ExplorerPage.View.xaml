<?xml version="1.0" encoding="UTF-8" ?>
<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Spine.FileManager.Pages.ExplorerPage"
    x:TypeArguments="ExplorerPageViewModel"
    x:DataType="ExplorerPageViewModel">

    <ContentPage.Resources>
        <Color x:Key="SelectionLight">#D3E3FD</Color>
        <Color x:Key="SelectionDark">#2B4C80</Color>
        <Color x:Key="Accent">#2F6FEB</Color>
        <Color x:Key="AccentDark">#7FA6F5</Color>
        <!-- Spine draws the SVG at the button's size inside its own padding; a button padding would shrink it a second time. -->
        <Style x:Key="ToolButton" TargetType="ImageButton">
            <Setter Property="WidthRequest" Value="32" />
            <Setter Property="HeightRequest" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SvgImageSource.Padding" Value="3" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="SvgImageSource.EnableSvg" Value="True" />
            <Setter Property="SvgImageSource.LightTintColor" Value="#1B1B1B" />
            <Setter Property="SvgImageSource.DarkTintColor" Value="#E8E8E8" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.3" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        <!-- A sidebar entry's glyph, tinted with the accent; Spine's SVG tint works on an ImageButton. The row takes the taps. -->
        <Style x:Key="SidebarGlyph" TargetType="ImageButton">
            <!-- Spine's glyphs leave room inside their view box; the button is larger than the glyph looks. -->
            <Setter Property="WidthRequest" Value="28" />
            <Setter Property="HeightRequest" Value="28" />
            <Setter Property="Margin" Value="-5,0,-3,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="InputTransparent" Value="True" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="SvgImageSource.EnableSvg" Value="True" />
            <Setter Property="SvgImageSource.LightTintColor" Value="{StaticResource Accent}" />
            <Setter Property="SvgImageSource.DarkTintColor" Value="{StaticResource AccentDark}" />
        </Style>
        <!-- The chevron glyph fills only the middle half of its square and its stroke is thin, so the square is large and
             pulled in by its margin to keep the header's height. -->
        <!-- A linked device's reachability: green on the local network, grey offline, amber while it is checked. -->
        <Style x:Key="StatusDot" TargetType="BoxView">
            <Setter Property="WidthRequest" Value="8" />
            <Setter Property="HeightRequest" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Color" Value="#E0A030" />
            <Setter Property="HorizontalOptions" Value="End" />
            <Setter Property="VerticalOptions" Value="End" />
            <Setter Property="InputTransparent" Value="True" />
        </Style>
        <Style x:Key="SortChevron" TargetType="ImageButton">
            <Setter Property="WidthRequest" Value="22" />
            <Setter Property="HeightRequest" Value="22" />
            <Setter Property="Margin" Value="-2,-2,-5,-2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="InputTransparent" Value="True" />
            <Setter Property="VerticalOptions" Value="Center" />
            <!-- Only the sorted column shows its chevron; its header's trigger turns it on. -->
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Opacity" Value="0.9" />
            <Setter Property="SvgImageSource.EnableSvg" Value="True" />
            <Setter Property="SvgImageSource.Padding" Value="0" />
            <Setter Property="SvgImageSource.LightTintColor" Value="#1B1B1B" />
            <Setter Property="SvgImageSource.DarkTintColor" Value="#E8E8E8" />
        </Style>
        <!-- A thin line to drag, with a wider transparent edge to hit. -->
        <Style x:Key="Grip" TargetType="Grid">
            <Setter Property="WidthRequest" Value="8" />
            <Setter Property="BackgroundColor" Value="Transparent" />
        </Style>
        <Style x:Key="GripLine" TargetType="BoxView">
            <Setter Property="WidthRequest" Value="1" />
            <Setter Property="Margin" Value="0,9" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="Color" Value="{AppThemeBinding Light=#D5D7DB, Dark=#3A3C40}" />
        </Style>
        <!-- Spine's glyphs leave a fifth of their box empty: with little padding they draw about 18 points tall, as in the concept image. -->
        <Style x:Key="CommandIcon" TargetType="ImageButton" BasedOn="{StaticResource ToolButton}">
            <Setter Property="WidthRequest" Value="36" />
            <Setter Property="HeightRequest" Value="30" />
            <Setter Property="SvgImageSource.Padding" Value="2" />
        </Style>
        <Style x:Key="CommandGroup" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="HeightRequest" Value="32" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <!-- A place in This Device or Cloud: a click opens it, files dropped on it go there, right-click hides it. -->
        <DataTemplate x:Key="PlaceTemplate" x:DataType="PlaceRow">
                        <Border Padding="8,0" Margin="8,1" HeightRequest="{DynamicResource SidebarItemHeight}" StrokeThickness="0" StrokeShape="RoundRectangle 6" BackgroundColor="Transparent"
                ContextMenu.Items="{Binding PlaceMenu, Source={RelativeSource AncestorType={x:Type ExplorerPageViewModel}}}" ContextMenu.CommandParameter="{Binding .}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsCurrent}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SelectionLight}, Dark={StaticResource SelectionDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenPlaceCommand, Source={RelativeSource AncestorType={x:Type ExplorerPageViewModel}}}" CommandParameter="{Binding .}" />
                                <DropGestureRecognizer DragOver="OnFileDragOver" DragLeave="OnFileDragLeave" Drop="OnFileDrop" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <ImageButton Style="{StaticResource SidebarGlyph}" SvgImageSource.Svg="{Binding Glyph}" />
                                <Label Grid.Column="1" Text="{Binding Name}" FontSize="{DynamicResource SidebarFontSize}" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                            </Grid>
                        </Border>
                    </DataTemplate>
        <Style x:Key="PreviewAction" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#E3E5E8, Dark=#34363A}" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="Padding" Value="4,8" />
        </Style>
        <Style x:Key="PreviewActionLabel" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>
        <Style x:Key="SidebarSection" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Padding" Value="16,14,16,4" />
        </Style>
        <Style x:Key="HomeSection" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>
        <Style x:Key="HomeCard" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#E3E5E8, Dark=#34363A}" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F7F8FA, Dark=#26272A}" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <Style x:Key="Crumb" TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="HeightRequest" Value="28" />
            <Setter Property="MinimumWidthRequest" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#1B1B1B, Dark=#E8E8E8}" />
        </Style>
        <Style x:Key="ColumnHeader" TargetType="Label">
            <Setter Property="FontSize" Value="{DynamicResource SidebarFontSize}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#5F6670, Dark=#9DA3AB}" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style x:Key="Cell" TargetType="Label">
            <Setter Property="FontSize" Value="{DynamicResource ItemFontSize}" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
    </ContentPage.Resources>

    <Grid x:Name="Root" ColumnDefinitions="Auto,*,Auto,Auto">
        <Grid.GestureRecognizers>
            <!-- Takes nothing; tells a dragged tab it is still over a window (Services/TabDrag). -->
            <DropGestureRecognizer DragOver="OnWindowDragOver" DragLeave="OnWindowDragLeave" />
        </Grid.GestureRecognizers>

        <!-- Sidebar, as in the concept image: Home, Favorites (reorderable, right-click to remove), This Device (places and
             disks), Other Devices, then Network and Backups dimmed until they exist; Settings at the foot. -->
        <Grid x:Name="Sidebar" WidthRequest="{Binding SidebarWidth}" IsVisible="{Binding ShowsSidebar}" Padding="{Binding SidebarPadding}" RowDefinitions="*,Auto"
              BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#1E1F22}">
            <!-- Everything but Settings scrolls when the window is lower than the sidebar. -->
            <ScrollView VerticalScrollBarVisibility="Never">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <Border Padding="8,0" Margin="8,10,8,1" HeightRequest="{DynamicResource SidebarItemHeight}" StrokeThickness="0" StrokeShape="RoundRectangle 6" BackgroundColor="Transparent">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsHome}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SelectionLight}, Dark={StaticResource SelectionDark}}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShowHomeCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <ImageButton Style="{StaticResource SidebarGlyph}" SvgImageSource.Svg="House.svg" />
                    <Label Grid.Column="1" Text="{String Home.Title}" FontSize="{DynamicResource SidebarFontSize}" VerticalTextAlignment="Center" />
                </Grid>
            </Border>
            <Label Grid.Row="1" Text="{String Explorer.Favorites}" Style="{StaticResource SidebarSection}" />
            <CollectionView Grid.Row="2" ItemsSource="{Binding Favorites}" SelectionMode="None" HeightRequest="{Binding FavoritesHeight}" VerticalScrollBarVisibility="Never"
                            Reorder.Mode="LongPress" Reorder.Command="{Binding SaveFavoriteOrderCommand}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="FavoriteRow">
                        <Border Padding="8,0" Margin="8,1" HeightRequest="{DynamicResource SidebarItemHeight}" StrokeThickness="0" StrokeShape="RoundRectangle 6" BackgroundColor="Transparent" Opacity="{Binding Dimmed}"
                              ContextMenu.Items="{Binding FavoriteMenu, Source={RelativeSource AncestorType={x:Type ExplorerPageViewModel}}}" ContextMenu.CommandParameter="{Binding .}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsCurrent}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SelectionLight}, Dark={StaticResource SelectionDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenFavoriteCommand, Source={RelativeSource AncestorType={x:Type ExplorerPageViewModel}}}" CommandParameter="{Binding .}" />
                                <DropGestureRecognizer DragOver="OnFileDragOver" DragLeave="OnFileDragLeave" Drop="OnFileDrop" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Image Source="folder.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" Margin="0,0,2,0" />
                                <Label Grid.Column="1" Text="{Binding Name}" FontSize="{DynamicResource SidebarFontSize}" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Label Grid.Row="3" Text="{String Explorer.FavoritesHint}" IsVisible="{Binding HasNoFavorites}" FontSize="12" Opacity="0.5" Padding="16,0,16,8" />
            <Label Grid.Row="4" Text="{String Home.ThisDevice}" Style="{StaticResource SidebarSection}" />
            <CollectionView Grid.Row="5" ItemsSource="{Binding Places}" SelectionMode="None" HeightRequest="{Binding PlacesHeight}" VerticalScrollBarVisibility="Never"
                            ItemTemplate="{StaticResource PlaceTemplate}">
            </CollectionView>

            <!-- The trash closes This Device, as in Finder's Dock and Explorer's desktop. -->
            <Border Grid.Row="6" Padding="8,0" Margin="8,1" HeightRequest="{DynamicResource SidebarItemHeight}" StrokeThickness="0" StrokeShape="RoundRectangle 6" BackgroundColor="Transparent">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsTrashCurrent}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SelectionLight}, Dark={StaticResource SelectionDark}}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenTrashCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <ImageButton Style="{StaticResource SidebarGlyph}" SvgImageSource.Svg="Delete.svg" />
                    <Label Grid.Column="1" Text="{Binding TrashName}" FontSize="{DynamicResource SidebarFontSize}" VerticalTextAlignment="Center" />
                </Grid>
            </Border>

            <!-- Cloud: iCloud Drive and the other providers, apart from the disks of This Device. -->
            <Label Grid.Row="7" Text="{String Places.Cloud}" Style="{StaticResource SidebarSection}" IsVisible="{Binding HasCloud}" />
            <CollectionView Grid.Row="8" ItemsSource="{Binding CloudPlaces}" SelectionMode="None" HeightRequest="{Binding CloudHeight}" VerticalScrollBarVisibility="Never"
                            ItemTemplate="{StaticResource PlaceTemplate}" IsVisible="{Binding HasCloud}" />

            <!-- Other Devices: linked devices; files dropped on one are sent there. -->
            <Label Grid.Row="9" Text="{String Devices.Title}" Style="{StaticResource SidebarSection}" />
            <CollectionView Grid.Row="10" ItemsSource="{Binding Devices}" SelectionMode="None" HeightRequest="{Binding DevicesHeight}" VerticalScrollBarVisibility="Never">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="DeviceRow">
                        <Border Padding="8,0" Margin="8,1" HeightRequest="{DynamicResource SidebarItemHeight}" StrokeThickness="0" StrokeShape="RoundRectangle 6" BackgroundColor="Transparent"
                              ContextMenu.Items="{Binding Menu}" ContextMenu.CommandParameter="{Binding .}"
                              ToolTipProperties.Text="{Binding StatusLine}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsDropTarget}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#B7CCF7, Dark=#35589A}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <DropGestureRecognizer DragOver="OnFileDragOver" DragLeave="OnFileDragLeave" Drop="OnFileDrop" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Grid VerticalOptions="Center">
                                    <ImageButton Style="{StaticResource SidebarGlyph}" SvgImageSource.Svg="{Binding Glyph}" />
                                    <BoxView Style="{StaticResource StatusDot}" Margin="0,0,-2,3">
                                        <BoxView.Triggers>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding IsOnline}" Value="True"><Setter Property="Color" Value="#34C759" /></DataTrigger>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding IsOffline}" Value="True"><Setter Property="Color" Value="#A0A5AD" /></DataTrigger>
                                        </BoxView.Triggers>
                                    </BoxView>
                                </Grid>
                                <Label Grid.Column="1" Text="{Binding Name}" FontSize="{DynamicResource SidebarFontSize}" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="2" Text="{Binding ProgressText}" IsVisible="{Binding IsTransferring}" FontSize="12" VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#2F6FEB, Dark=#7FA6F5}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button Grid.Row="11" Text="{String Devices.Link}" Command="{Binding LinkDeviceCommand}" FontSize="12" Padding="12,0" HeightRequest="26" CornerRadius="13"
                    Margin="16,6,16,0" HorizontalOptions="Start" BackgroundColor="{AppThemeBinding Light=#E4ECFD, Dark=#25324D}" TextColor="{AppThemeBinding Light=#2F6FEB, Dark=#9BB9F7}" />

            <!-- Not built yet: shown dimmed so the sidebar has the concept image's sections. -->
            <Label Grid.Row="12" Text="{String Explorer.Network}" Style="{StaticResource SidebarSection}" />
            <Grid Grid.Row="13" ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="16,0" HeightRequest="{DynamicResource SidebarItemHeight}" Margin="0,1" Opacity="0.4">
                <ImageButton Style="{StaticResource SidebarGlyph}" SvgImageSource.Svg="Globe.svg" />
                <Label Grid.Column="1" Text="{String Explorer.Network.Soon}" FontSize="{DynamicResource SidebarFontSize}" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
            </Grid>
            <Label Grid.Row="14" Text="{String Explorer.Backups}" Style="{StaticResource SidebarSection}" />
            <Grid Grid.Row="15" ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="16,0" HeightRequest="{DynamicResource SidebarItemHeight}" Margin="0,1,0,8" Opacity="0.4">
                <ImageButton Style="{StaticResource SidebarGlyph}" SvgImageSource.Svg="Clock.svg" />
                <Label Grid.Column="1" Text="{String Explorer.Backups.Soon}" FontSize="{DynamicResource SidebarFontSize}" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
            </Grid>

            </Grid>
            </ScrollView>

            <!-- Settings at the sidebar's foot, as in the concept image. -->
            <Border Grid.Row="1" Padding="8,0" Margin="8,4,8,10" HeightRequest="{DynamicResource SidebarItemHeight}" StrokeThickness="0" StrokeShape="RoundRectangle 6" BackgroundColor="Transparent">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShowSettingsCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <ImageButton Style="{StaticResource SidebarGlyph}" SvgImageSource.Svg="Settings.svg" />
                    <Label Grid.Column="1" Text="{String Settings.Title}" FontSize="{DynamicResource SidebarFontSize}" VerticalTextAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- The sidebar's right edge resizes it. -->
        <Grid Style="{StaticResource Grip}" HorizontalOptions="End" Margin="0,0,-4,0" ZIndex="1" IsVisible="{Binding ShowsSidebar}" ClassId="SidebarWidth">
            <Grid.GestureRecognizers><PanGestureRecognizer PanUpdated="OnGripPanned" /><PointerGestureRecognizer PointerEntered="OnGripEntered" PointerMoved="OnGripEntered" PointerExited="OnGripExited" /></Grid.GestureRecognizers>
            <!-- Shown only under the pointer: the sidebar's own background marks its edge. -->
            <BoxView Style="{StaticResource GripLine}" Margin="0" Opacity="0" StyleId="HoverOnly" />
        </Grid>

        <Grid x:Name="Pane" Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*,Auto" ColumnDefinitions="*,Auto">
            <Grid.GestureRecognizers>
                <PointerGestureRecognizer PointerPressed="OnPanePressed" />
                <!-- Files dropped anywhere else in the pane go to the folder shown; a CollectionView takes no drop itself. -->
                <DropGestureRecognizer DragOver="OnFileDragOver" DragLeave="OnFileDragLeave" Drop="OnFileDrop" />
            </Grid.GestureRecognizers>

            <KeySink x:Name="Keys" WidthRequest="1" HeightRequest="1" Opacity="0" HorizontalOptions="Start" VerticalOptions="Start" />
            <VerticalStackLayout Grid.ColumnSpan="2">
            <!-- In Dual Pane, a line marks the pane the menus and the sidebar act on. -->
            <!-- Always there in Dual Pane, only its opacity follows focus: a line appearing on a press shifted the pane
                 and ended the drag that press started. -->
            <BoxView HeightRequest="2" IsVisible="{Binding IsPaneOfTwo}" Opacity="0" Color="{AppThemeBinding Light=#2F6FEB, Dark=#5B8DEF}">
                <BoxView.Triggers>
                    <DataTrigger TargetType="BoxView" Binding="{Binding MarksFocus}" Value="True">
                        <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                </BoxView.Triggers>
            </BoxView>
            <!-- Tabs, always at least one: a click shows the tab, × closes it, a drag moves it within the bar, to
                 another window or, let go outside the app's windows, to a window of its own. Tabs narrow as they grow
                 in number, as in a browser, rather than scroll: on the Mac a scroll view under the title bar makes
                 macOS treat the area as its own, drawing its bar over the tabs and taking their clicks. -->
            <Grid x:Name="TabBar" HeightRequest="{Binding TabBarHeight}" BackgroundColor="{AppThemeBinding Light=#E9EAEE, Dark=#16171A}">
                <Grid.GestureRecognizers>
                    <DropGestureRecognizer DragOver="OnTabDragOver" DragLeave="OnTabDragLeave" Drop="OnTabDrop" />
                </Grid.GestureRecognizers>
                <HorizontalStackLayout Padding="{Binding TabBarPadding}" Spacing="2">
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Tabs}" Spacing="2">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="ExplorerTab">
                                <!-- Edge-like: the active tab is raised, lighter and joined to the toolbar below it. -->
                                <Border WidthRequest="{Binding TabWidth, Source={RelativeSource AncestorType={x:Type ExplorerPageViewModel}}}"
                                        HeightRequest="{Binding TabHeight, Source={RelativeSource AncestorType={x:Type ExplorerPageViewModel}}}"
                                        Padding="10,0,2,0" StrokeThickness="0" StrokeShape="RoundRectangle 8,8,0,0" BackgroundColor="Transparent"
                                        ContextMenu.Items="{Binding TabMenu, Source={RelativeSource AncestorType={x:Type ExplorerPageViewModel}}}" ContextMenu.CommandParameter="{Binding .}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsHovered}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#DDDFE4, Dark=#202124}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <DragGestureRecognizer DragStarting="OnTabDragStarting" DropCompleted="OnTabDropCompleted" />
                                        <DropGestureRecognizer DragOver="OnTabDragOver" DragLeave="OnTabDragLeave" Drop="OnTabDrop" />
                                        <PointerGestureRecognizer PointerEntered="OnTabPointerEntered" PointerExited="OnTabPointerExited" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                        <Grid InputTransparent="True" VerticalOptions="Center">
                                            <Image Source="folder.png" WidthRequest="16" HeightRequest="16" IsVisible="{Binding IsHome, Converter={StaticResource Not}}" />
                                            <ImageButton SvgImageSource.Svg="House.svg" SvgImageSource.EnableSvg="True" SvgImageSource.LightTintColor="#2F6FEB" SvgImageSource.DarkTintColor="#7FA6F5"
                                                         WidthRequest="26" HeightRequest="26" Margin="-5" Padding="0" BackgroundColor="Transparent" IsVisible="{Binding IsHome}" />
                                        </Grid>
                                        <Label Grid.Column="1" Text="{Binding Title}" FontSize="{DynamicResource SidebarFontSize}" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" InputTransparent="True" />
                                        <!-- A button takes the click, so a tab answers like the other controls (keyboard, accessibility). -->
                                        <Button Grid.ColumnSpan="3" BackgroundColor="Transparent" Padding="0" MinimumHeightRequest="0" MinimumWidthRequest="0" SemanticProperties.Description="{Binding Title}"
                                                Command="{Binding SelectTabCommand, Source={RelativeSource AncestorType={x:Type ExplorerPageViewModel}}}" CommandParameter="{Binding .}" />
                                        <Button Grid.Column="2" Text="×" FontSize="14" Padding="6,0" HeightRequest="22" MinimumWidthRequest="0" CornerRadius="4" BackgroundColor="Transparent"
                                                TextColor="{AppThemeBinding Light=#555, Dark=#BBB}" SemanticProperties.Description="{String Menu.CloseTab}" ToolTipProperties.Text="{String Menu.CloseTab}"
                                                Opacity="0" Command="{Binding CloseTabCommand, Source={RelativeSource AncestorType={x:Type ExplorerPageViewModel}}}" CommandParameter="{Binding .}">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding ShowsClose}" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                    <Button Text="+" FontSize="18" WidthRequest="28" HeightRequest="28" Padding="0" MinimumHeightRequest="0" MinimumWidthRequest="0" CornerRadius="6" VerticalOptions="Center"
                            BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#444, Dark=#CCC}" Command="{Binding NewTabCommand}"
                            SemanticProperties.Description="{String Menu.NewTab}" ToolTipProperties.Text="{String Menu.NewTab}" />
                </HorizontalStackLayout>
            </Grid>

            <!-- Toolbar: history and up, the breadcrumb with all the room left, refresh and search. -->
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="2" Padding="8,6,8,2">
                <ImageButton Style="{StaticResource ToolButton}" SvgImageSource.Svg="ChevronLeft.svg" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}"
                             SemanticProperties.Description="{String Explorer.Back}" ToolTipProperties.Text="{String Explorer.Back}" />
                <ImageButton Grid.Column="1" Style="{StaticResource ToolButton}" SvgImageSource.Svg="ChevronRight.svg" Command="{Binding ForwardCommand}" IsEnabled="{Binding CanGoForward}"
                             SemanticProperties.Description="{String Explorer.Forward}" ToolTipProperties.Text="{String Explorer.Forward}" />
                <ImageButton Grid.Column="2" Style="{StaticResource ToolButton}" SvgImageSource.Svg="ChevronUp.svg" Command="{Binding UpCommand}" IsEnabled="{Binding CanGoUp}"
                             SemanticProperties.Description="{String Explorer.Up}" ToolTipProperties.Text="{String Explorer.Up}" />
                <!-- Breadcrumb in a capsule: a segment opens its folder, the chevron after it lists that folder's
                     subfolders. As in Windows, segments that do not fit fold from the root end into « before them,
                     which lists them nearest first; the current folder always shows. -->
                <Border Grid.Column="3" Margin="6,0" Padding="4,0" HeightRequest="32" StrokeThickness="0" StrokeShape="RoundRectangle 8"
                        BackgroundColor="{AppThemeBinding Light=#F1F2F4, Dark=#2A2B2E}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Button x:Name="CrumbOverflow" Text="«" Style="{StaticResource Crumb}" Padding="6,0" MenuButton.Items="{Binding CollapsedMenu}" IsVisible="{Binding ShowsOverflow}"
                                SemanticProperties.Description="{String Explorer.EarlierFolders}" ToolTipProperties.Text="{String Explorer.EarlierFolders}" />
                        <Label Grid.Column="1" Text="{String Home.Title}" FontSize="13" Padding="6,0" VerticalOptions="Center" IsVisible="{Binding IsHome}" />
                        <!-- A click on the capsule's empty part turns it into the path as text, selected (⌘L / Ctrl+L too). -->
                        <Grid x:Name="CrumbArea" Grid.Column="1" IsClippedToBounds="True" IsVisible="{Binding ShowsCrumbs}" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding EditPathCommand}" />
                            </Grid.GestureRecognizers>
                            <HorizontalStackLayout x:Name="Crumbs" BindableLayout.ItemsSource="{Binding Segments}" VerticalOptions="Center" HorizontalOptions="Start">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="BreadcrumbSegment">
                                        <HorizontalStackLayout IsVisible="{Binding IsCollapsed, Converter={StaticResource Not}}" SizeChanged="OnCrumbSizeChanged">
                                            <HorizontalStackLayout.GestureRecognizers>
                                                <DropGestureRecognizer DragOver="OnFileDragOver" DragLeave="OnFileDragLeave" Drop="OnFileDrop" />
                                            </HorizontalStackLayout.GestureRecognizers>
                                            <Button Text="{Binding Name}" Style="{StaticResource Crumb}"
                                                    Command="{Binding OpenLocationCommand, Source={RelativeSource AncestorType={x:Type ExplorerPageViewModel}}}" CommandParameter="{Binding Location}" />
                                            <Button Text="›" Style="{StaticResource Crumb}" Padding="4,0" MenuButton.Items="{Binding Children}"
                                                    SemanticProperties.Description="{String Explorer.Subfolders}" />
                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </Grid>
                        <Entry x:Name="PathField" Grid.ColumnSpan="2" ClassId="Bare" Text="{Binding PathEdit}" FontSize="13" BackgroundColor="Transparent" Margin="4,0"
                               IsVisible="{Binding IsEditingPath}" VerticalOptions="Center" ReturnCommand="{Binding CommitPathCommand}" Unfocused="OnPathFieldUnfocused"
                               SemanticProperties.Description="{String Menu.EditPath}" />
                    </Grid>
                </Border>
                <ImageButton Grid.Column="4" Style="{StaticResource ToolButton}" SvgImageSource.Svg="Refresh.svg" Command="{Binding RefreshCommand}"
                             SemanticProperties.Description="{String Explorer.Refresh}" ToolTipProperties.Text="{String Explorer.Refresh}" />
                <!-- Search folds out of its magnifier and folds back when left empty. -->
                <Grid Grid.Column="5">
                    <ImageButton Style="{StaticResource ToolButton}" SvgImageSource.Svg="Search.svg" Command="{Binding FindCommand}" IsVisible="{Binding IsSearchOpen, Converter={StaticResource Not}}"
                                 SemanticProperties.Description="{String Explorer.Search}" ToolTipProperties.Text="{String Explorer.Search}" />
                    <Border x:Name="SearchCapsule" WidthRequest="200" HeightRequest="32" Margin="4,0,0,0" Padding="10,0,4,0" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                            BackgroundColor="{AppThemeBinding Light=#F1F2F4, Dark=#2A2B2E}" Stroke="{AppThemeBinding Light=#2F6FEB, Dark=#5B8DEF}"
                            IsVisible="{Binding IsSearchOpen}">
                        <Entry x:Name="FilterField" ClassId="Bare" Text="{Binding Filter}" Placeholder="{String Explorer.Search}" FontSize="13" BackgroundColor="Transparent"
                               ClearButtonVisibility="WhileEditing" VerticalOptions="Center" Focused="OnFilterFocused" Unfocused="OnFilterUnfocused"
                               SemanticProperties.Description="{String Explorer.Filter}" />
                    </Border>
                </Grid>
            </Grid>

            <!-- Command bar, as in the concept image: New with its label, the clipboard and rename in one framed group,
                 Delete in red on its own; then hidden files and the view. -->
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8" Padding="8,0,8,6" IsVisible="{Binding ShowsFiles}">
                <Border Style="{StaticResource CommandGroup}" Padding="8,0,12,0" ToolTipProperties.Text="{String Menu.NewFolder}" SemanticProperties.Description="{String Menu.NewFolder}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NewFolderCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="2">
                        <ImageButton Style="{StaticResource CommandIcon}" SvgImageSource.Svg="Plus.svg" WidthRequest="26" InputTransparent="True" />
                        <Label Text="{String Commands.New}" FontSize="13" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CommandGroup}">
                    <HorizontalStackLayout>
                        <ImageButton Style="{StaticResource CommandIcon}" SvgImageSource.Svg="Cut.svg" Command="{Binding CutCommand}" IsEnabled="{Binding HasSelection}"
                                     SemanticProperties.Description="{String Menu.Cut}" ToolTipProperties.Text="{String Menu.Cut}" />
                        <ImageButton Style="{StaticResource CommandIcon}" SvgImageSource.Svg="Copy.svg" Command="{Binding CopyCommand}" IsEnabled="{Binding HasSelection}"
                                     SemanticProperties.Description="{String Menu.Copy}" ToolTipProperties.Text="{String Menu.Copy}" />
                        <ImageButton Style="{StaticResource CommandIcon}" SvgImageSource.Svg="Paste.svg" Command="{Binding PasteCommand}"
                                     SemanticProperties.Description="{String Menu.Paste}" ToolTipProperties.Text="{String Menu.Paste}" />
                        <ImageButton Style="{StaticResource CommandIcon}" SvgImageSource.Svg="Duplicate.svg" Command="{Binding DuplicateCommand}" IsEnabled="{Binding HasSelection}"
                                     SemanticProperties.Description="{String Menu.Duplicate}" ToolTipProperties.Text="{String Menu.Duplicate}" />
                        <ImageButton Style="{StaticResource CommandIcon}" SvgImageSource.Svg="Edit.svg" Command="{Binding RenameCommand}" IsEnabled="{Binding HasSelection}"
                                     SemanticProperties.Description="{String Menu.Rename}" ToolTipProperties.Text="{String Menu.Rename}" />
                    </HorizontalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CommandGroup}">
                    <ImageButton Style="{StaticResource CommandIcon}" SvgImageSource.Svg="Delete.svg" Command="{Binding DeleteCommand}" IsEnabled="{Binding HasSelection}"
                                 SvgImageSource.LightTintColor="#C5221F" SvgImageSource.DarkTintColor="#F28B82"
                                 SemanticProperties.Description="{String Menu.Delete}" ToolTipProperties.Text="{String Menu.Delete}" />
                </Border>
                <ImageButton Grid.Column="4" Style="{StaticResource ToolButton}" Command="{Binding ToggleHiddenCommand}"
                             SemanticProperties.Description="{String Explorer.ShowHidden}" ToolTipProperties.Text="{String Explorer.ShowHidden}">
                    <ImageButton.Triggers>
                        <DataTrigger TargetType="ImageButton" Binding="{Binding ShowHidden}" Value="True">
                            <Setter Property="SvgImageSource.Svg" Value="Eye.svg" />
                        </DataTrigger>
                        <DataTrigger TargetType="ImageButton" Binding="{Binding ShowHidden}" Value="False">
                            <Setter Property="SvgImageSource.Svg" Value="EyeOff.svg" />
                        </DataTrigger>
                    </ImageButton.Triggers>
                </ImageButton>
                <!-- Icons only, as in Finder: a segment with a title shows it as text too. -->
                <SegmentedControl Grid.Column="5" SelectedIndex="{Binding ViewIndex}" VerticalOptions="Center" Margin="4,0,0,0"
                                  ToolTipProperties.Text="{String Explorer.View}" SemanticProperties.Description="{String Explorer.View}">
                    <Segment Svg="List.svg" />
                    <Segment Svg="Grid.svg" />
                </SegmentedControl>
            </Grid>

            <!-- Search: the field filters the folder shown; here the search reaches into its subfolders. -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10" Padding="16,0,16,6" IsVisible="{Binding ShowsSearchScope}">
                <SegmentedControl SelectedIndex="{Binding SearchScope}" WidthRequest="320" HorizontalOptions="Start">
                    <Segment Title="{String Search.ThisFolder}" />
                    <Segment Title="{String Search.Subfolders}" />
                </SegmentedControl>
                <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsSearching}" IsVisible="{Binding IsSearching}" HeightRequest="16" WidthRequest="16" />
                <Button Grid.Column="3" Text="{String Search.Stop}" Command="{Binding StopSearchingCommand}" IsVisible="{Binding IsSearching}" FontSize="13" />
            </Grid>
            <!-- Divides the toolbar from the files, as in the concept image. -->
            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E3E5E8, Dark=#34363A}" />
            </VerticalStackLayout>

            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Error}" IsVisible="{Binding HasError}" FontSize="13" Padding="16,8"
                   TextColor="{AppThemeBinding Light=#B3261E, Dark=#F2B8B5}" BackgroundColor="{AppThemeBinding Light=#FDECEA, Dark=#3B1F1E}" />

            <!-- Column headers: a click sorts, a second click reverses. -->
            <!-- Column headers: a click sorts, a second click reverses; the sorted column shows a chevron. The grip on a
                 column's right edge resizes it; Name takes what is left. -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" Padding="8,0" HeightRequest="34" IsVisible="{Binding ShowsList}">
                <BoxView Grid.ColumnSpan="4" HeightRequest="1" VerticalOptions="End" Margin="-8,0" InputTransparent="True" Color="{AppThemeBinding Light=#E3E5E8, Dark=#34363A}" />
                <Grid  Padding="38,0,0,0" ColumnDefinitions="*,Auto">
                    <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SortByCommand}" CommandParameter="Name" /></Grid.GestureRecognizers>
                    <HorizontalStackLayout Spacing="0">
                        <Label Text="{String Explorer.Column.Name}" Style="{StaticResource ColumnHeader}" Padding="8,0,2,0">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding NameSorted}" Value="True">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=#1B1B1B, Dark=#E8E8E8}" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <ImageButton Style="{StaticResource SortChevron}" SvgImageSource.Svg="{Binding NameChevron}">
                            <ImageButton.Triggers>
                                <DataTrigger TargetType="ImageButton" Binding="{Binding NameSorted}" Value="True">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </ImageButton.Triggers>
                        </ImageButton>
                    </HorizontalStackLayout>
                </Grid>
                <Grid Grid.Column="1" WidthRequest="{Binding ModifiedWidth}" IsVisible="{Binding HasColumns}" ColumnDefinitions="*,Auto">
                    <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SortByCommand}" CommandParameter="Modified" /></Grid.GestureRecognizers>
                    <HorizontalStackLayout Spacing="0">
                        <Label Text="{String Explorer.Column.Modified}" Style="{StaticResource ColumnHeader}" Padding="8,0,2,0">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ModifiedSorted}" Value="True">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=#1B1B1B, Dark=#E8E8E8}" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <ImageButton Style="{StaticResource SortChevron}" SvgImageSource.Svg="{Binding ModifiedChevron}">
                            <ImageButton.Triggers>
                                <DataTrigger TargetType="ImageButton" Binding="{Binding ModifiedSorted}" Value="True">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </ImageButton.Triggers>
                        </ImageButton>
                    </HorizontalStackLayout>
                    <Grid Grid.Column="1" Style="{StaticResource Grip}" ClassId="ModifiedWidth">
                        <Grid.GestureRecognizers><PanGestureRecognizer PanUpdated="OnGripPanned" /><PointerGestureRecognizer PointerEntered="OnGripEntered" PointerMoved="OnGripEntered" PointerExited="OnGripExited" /></Grid.GestureRecognizers>
                        <BoxView Style="{StaticResource GripLine}" />
                    </Grid>
                </Grid>
                <Grid Grid.Column="2" WidthRequest="{Binding SizeWidth}" ColumnDefinitions="*,Auto">
                    <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SortByCommand}" CommandParameter="Size" /></Grid.GestureRecognizers>
                    <HorizontalStackLayout Spacing="0" HorizontalOptions="End">
                        <Label Text="{String Explorer.Column.Size}" Style="{StaticResource ColumnHeader}" Padding="8,0,2,0">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding SizeSorted}" Value="True">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=#1B1B1B, Dark=#E8E8E8}" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <ImageButton Style="{StaticResource SortChevron}" SvgImageSource.Svg="{Binding SizeChevron}">
                            <ImageButton.Triggers>
                                <DataTrigger TargetType="ImageButton" Binding="{Binding SizeSorted}" Value="True">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </ImageButton.Triggers>
                        </ImageButton>
                    </HorizontalStackLayout>
                    <Grid Grid.Column="1" Style="{StaticResource Grip}" ClassId="SizeWidth">
                        <Grid.GestureRecognizers><PanGestureRecognizer PanUpdated="OnGripPanned" /><PointerGestureRecognizer PointerEntered="OnGripEntered" PointerMoved="OnGripEntered" PointerExited="OnGripExited" /></Grid.GestureRecognizers>
                        <BoxView Style="{StaticResource GripLine}" />
                    </Grid>
                </Grid>
                <Grid Grid.Column="3" WidthRequest="{Binding KindWidth}" IsVisible="{Binding HasColumns}" ColumnDefinitions="*,Auto">
                    <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SortByCommand}" CommandParameter="Kind" /></Grid.GestureRecognizers>
                    <HorizontalStackLayout Spacing="0">
                        <Label Text="{String Explorer.Column.Kind}" Style="{StaticResource ColumnHeader}" Padding="8,0,2,0">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding KindSorted}" Value="True">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=#1B1B1B, Dark=#E8E8E8}" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <ImageButton Style="{StaticResource SortChevron}" SvgImageSource.Svg="{Binding KindChevron}">
                            <ImageButton.Triggers>
                                <DataTrigger TargetType="ImageButton" Binding="{Binding KindSorted}" Value="True">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </ImageButton.Triggers>
                        </ImageButton>
                    </HorizontalStackLayout>
                    <Grid Grid.Column="1" Style="{StaticResource Grip}" ClassId="KindWidth">
                        <Grid.GestureRecognizers><PanGestureRecognizer PanUpdated="OnGripPanned" /><PointerGestureRecognizer PointerEntered="OnGripEntered" PointerMoved="OnGripEntered" PointerExited="OnGripExited" /></Grid.GestureRecognizers>
                        <BoxView Style="{StaticResource GripLine}" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- Every row is one height; measuring only the first keeps a 100 000-row list from measuring them all. -->
            <FileListView x:Name="List" Grid.Row="3" ItemsSource="{Binding Rows}" SelectionMode="None" ItemSizingStrategy="MeasureFirstItem" IsVisible="{Binding ShowsList}"
                          ContextMenu.Items="{Binding BackgroundMenu}">
                <FileListView.GestureRecognizers>
                    <PointerGestureRecognizer PointerPressed="OnListPressed" />
                    <!-- A drag that does not start on a name or icon draws a selection rectangle. -->
                    <PanGestureRecognizer PanUpdated="OnListPanned" />
                </FileListView.GestureRecognizers>
                <FileListView.ItemTemplate>
                    <DataTemplate x:DataType="ItemRow">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" HeightRequest="{DynamicResource ItemRowHeight}" Padding="16,0,8,0" Opacity="{Binding Dimmed}"
                              ContextMenu.Items="{Binding Menu}" ContextMenu.CommandParameter="{Binding .}">
                            <Grid.Triggers>
                                <DataTrigger TargetType="Grid" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SelectionLight}, Dark={StaticResource SelectionDark}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Grid" Binding="{Binding IsDropTarget}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#B7CCF7, Dark=#35589A}" />
                                </DataTrigger>
                            </Grid.Triggers>
                            <Grid.GestureRecognizers>
                                <DropGestureRecognizer DragOver="OnFileDragOver" DragLeave="OnFileDragLeave" Drop="OnFileDrop" />
                                <TapGestureRecognizer NumberOfTapsRequired="2" Command="{Binding ActivateCommand, Source={RelativeSource AncestorType={x:Type ExplorerPageViewModel}}}" CommandParameter="{Binding .}" />
                                <TapGestureRecognizer Command="{Binding TapCommand, Source={RelativeSource AncestorType={x:Type ExplorerPageViewModel}}}" CommandParameter="{Binding .}" />
                                <TapGestureRecognizer Buttons="Secondary" Command="{Binding RowSecondaryTapCommand, Source={RelativeSource AncestorType={x:Type ExplorerPageViewModel}}}" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <!-- Files are dragged by their icon or name, as in Finder and Explorer; the name is only as wide as its text. -->
                            <Image Source="{Binding Icon}" WidthRequest="{DynamicResource ItemIconSize}" HeightRequest="{DynamicResource ItemIconSize}" VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <DragGestureRecognizer DragStarting="OnRowDragStarting" DropCompleted="OnRowDropCompleted" />
                                    <PointerGestureRecognizer PointerPressed="OnItemPressed" />
                                </Image.GestureRecognizers>
                            </Image>
                            <!-- A search result also says which folder it is in. -->
                            <Label Grid.Column="1" Style="{StaticResource Cell}" HorizontalOptions="Start">
                                <Label.GestureRecognizers>
                                    <DragGestureRecognizer DragStarting="OnRowDragStarting" DropCompleted="OnRowDropCompleted" />
                                    <PointerGestureRecognizer PointerPressed="OnItemPressed" />
                                </Label.GestureRecognizers>
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Name}" />
                                        <Span Text="{Binding WhereSuffix}" TextColor="{AppThemeBinding Light=#8A8F98, Dark=#8E939B}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Grid.Column="2" Text="{Binding Modified}" Style="{StaticResource Cell}" Opacity="0.7" WidthRequest="{Binding ModifiedWidth, Source={RelativeSource AncestorType={x:Type ExplorerPageViewModel}}}" IsVisible="{Binding HasColumns, Source={RelativeSource AncestorType={x:Type ExplorerPageViewModel}}}" />
                            <Label Grid.Column="3" Text="{Binding Size}" Style="{StaticResource Cell}" Opacity="0.7" WidthRequest="{Binding SizeWidth, Source={RelativeSource AncestorType={x:Type ExplorerPageViewModel}}}" HorizontalTextAlignment="End" />
                            <Label Grid.Column="4" Text="{Binding Kind}" Style="{StaticResource Cell}" Opacity="0.7" WidthRequest="{Binding KindWidth, Source={RelativeSource AncestorType={x:Type ExplorerPageViewModel}}}" IsVisible="{Binding HasColumns, Source={RelativeSource AncestorType={x:Type ExplorerPageViewModel}}}" />
                        </Grid>
                    </DataTemplate>
                </FileListView.ItemTemplate>
                <FileListView.EmptyView>
                    <Label Text="{String Explorer.Empty}" IsVisible="{Binding IsLoading, Converter={StaticResource Not}}" Opacity="0.5" HorizontalTextAlignment="Center" Padding="24" />
                </FileListView.EmptyView>
            </FileListView>
            <Border x:Name="Marquee" Grid.Row="2" Grid.RowSpan="2" IsVisible="False" InputTransparent="True" HorizontalOptions="Start" VerticalOptions="Start" ZIndex="2"
                    StrokeThickness="1" StrokeShape="Rectangle" Stroke="{AppThemeBinding Light=#2F6FEB, Dark=#5B8DEF}"
                    BackgroundColor="{AppThemeBinding Light=#332F6FEB, Dark=#335B8DEF}" />

            <!-- Icons: a second list rather than a new ItemsLayout, which a shown CollectionView ignores on iOS. -->
            <FileListView x:Name="Icons" Grid.Row="2" Grid.RowSpan="2" ItemsSource="{Binding Rows}" SelectionMode="None" ItemSizingStrategy="MeasureFirstItem" IsVisible="{Binding ShowsIconGrid}" Margin="8,8,8,0"
                          ContextMenu.Items="{Binding BackgroundMenu}">
                <FileListView.GestureRecognizers>
                    <PointerGestureRecognizer PointerPressed="OnListPressed" />
                    <PanGestureRecognizer PanUpdated="OnListPanned" />
                </FileListView.GestureRecognizers>
                <FileListView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="{Binding GridSpan}" VerticalItemSpacing="4" HorizontalItemSpacing="4" />
                </FileListView.ItemsLayout>
                <FileListView.ItemTemplate>
                    <DataTemplate x:DataType="ItemRow">
                        <Grid WidthRequest="{DynamicResource GridCellWidth}" HorizontalOptions="Center" Padding="4" Opacity="{Binding Dimmed}"
                              ContextMenu.Items="{Binding Menu}" ContextMenu.CommandParameter="{Binding .}">
                            <Grid.Triggers>
                                <DataTrigger TargetType="Grid" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SelectionLight}, Dark={StaticResource SelectionDark}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Grid" Binding="{Binding IsDropTarget}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#B7CCF7, Dark=#35589A}" />
                                </DataTrigger>
                            </Grid.Triggers>
                            <Grid.GestureRecognizers>
                                <DragGestureRecognizer DragStarting="OnRowDragStarting" DropCompleted="OnRowDropCompleted" />
                                <PointerGestureRecognizer PointerPressed="OnItemPressed" />
                                <DropGestureRecognizer DragOver="OnFileDragOver" DragLeave="OnFileDragLeave" Drop="OnFileDrop" />
                                <TapGestureRecognizer NumberOfTapsRequired="2" Command="{Binding ActivateCommand, Source={RelativeSource AncestorType={x:Type ExplorerPageViewModel}}}" CommandParameter="{Binding .}" />
                                <TapGestureRecognizer Command="{Binding TapCommand, Source={RelativeSource AncestorType={x:Type ExplorerPageViewModel}}}" CommandParameter="{Binding .}" />
                                <TapGestureRecognizer Buttons="Secondary" Command="{Binding RowSecondaryTapCommand, Source={RelativeSource AncestorType={x:Type ExplorerPageViewModel}}}" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="{DynamicResource GridNameHeight}" />
                            </Grid.RowDefinitions>
                            <Image Source="{Binding Icon}" WidthRequest="{DynamicResource GridIconSize}" HeightRequest="{DynamicResource GridIconSize}" Margin="0,4" />
                            <!-- UIKit truncates in the middle only on a single line; a tail cut lets the name wrap to two, as in Finder. -->
                            <Label Grid.Row="1" Text="{Binding Name}" FontSize="{DynamicResource SidebarFontSize}" HorizontalTextAlignment="Center" VerticalTextAlignment="Start" MaxLines="2" LineBreakMode="TailTruncation" />
                        </Grid>
                    </DataTemplate>
                </FileListView.ItemTemplate>
            </FileListView>

            <Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Padding="16,7" BackgroundColor="{AppThemeBinding Light=#F7F8FA, Dark=#26272A}">
                <BoxView Grid.ColumnSpan="2" HeightRequest="1" VerticalOptions="Start" Margin="-16,-7,-16,0" Color="{AppThemeBinding Light=#E3E5E8, Dark=#34363A}" />
                <HorizontalStackLayout Spacing="16">
                    <Label Text="{Binding Status}" FontSize="{DynamicResource SidebarFontSize}" TextColor="{AppThemeBinding Light=#5F6670, Dark=#9DA3AB}" VerticalTextAlignment="Center" />
                    <Label Text="{Binding DeviceActivity}" FontSize="{DynamicResource SidebarFontSize}" TextColor="{AppThemeBinding Light=#5F6670, Dark=#9DA3AB}" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                </HorizontalStackLayout>
                <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HeightRequest="14" WidthRequest="14" />
            </Grid>

            <!-- Preview, as in the concept image: picture, name, kind and size, Open and Open With, the facts with the
                 location as a link, and quick actions; × closes it. -->
            <ScrollView Grid.Row="2" Grid.RowSpan="2" Grid.Column="1" WidthRequest="{Binding PreviewWidth}" IsVisible="{Binding ShowsPreview}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">
                <Grid RowDefinitions="Auto,*">
                    <BoxView WidthRequest="1" HorizontalOptions="Start" Grid.RowSpan="2" Color="{AppThemeBinding Light=#E3E5E8, Dark=#34363A}" />
                    <ImageButton Style="{StaticResource ToolButton}" SvgImageSource.Svg="Close.svg" Command="{Binding TogglePreviewCommand}" HorizontalOptions="End" Margin="0,6,8,0"
                                 SemanticProperties.Description="{String Preview.Close}" ToolTipProperties.Text="{String Preview.Close}" />
                    <VerticalStackLayout Grid.Row="1" Padding="20,0,20,20" Spacing="12">
                        <Label Text="{String Preview.None}" IsVisible="{Binding PreviewTitle, Converter={StaticResource IsNull}}" FontSize="12" Opacity="0.5" HorizontalTextAlignment="Center" Margin="0,40,0,0" />
                        <VerticalStackLayout Spacing="12" IsVisible="{Binding PreviewTitle, Converter={StaticResource HasValue}}">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#26272A}" HeightRequest="{Binding PreviewImageHeight}">
                                <Image Source="{Binding PreviewImage}" Aspect="AspectFit" Margin="8" />
                            </Border>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding PreviewTitle}" FontSize="17" FontAttributes="Bold" LineBreakMode="MiddleTruncation" />
                                <Label Text="{Binding PreviewSummary}" FontSize="13" TextColor="{AppThemeBinding Light=#2F6FEB, Dark=#7FA6F5}" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Spacing="6">
                                <Button Text="{String Preview.Open}" Command="{Binding ActivateCommand}" FontSize="13" Padding="28,0" HeightRequest="30" CornerRadius="6"
                                        BackgroundColor="{AppThemeBinding Light=#2F6FEB, Dark=#3D7BF0}" TextColor="White" />
                                <Button Text="⌄" FontSize="15" Padding="10,0" HeightRequest="30" CornerRadius="6" IsVisible="{Binding HasOpenWith}"
                                        MenuButton.Items="{Binding PreviewOpenWith}" BackgroundColor="{AppThemeBinding Light=#E4ECFD, Dark=#25324D}" TextColor="{AppThemeBinding Light=#2F6FEB, Dark=#9BB9F7}"
                                        SemanticProperties.Description="{String Preview.OpenWith}" ToolTipProperties.Text="{String Preview.OpenWith}" />
                            </HorizontalStackLayout>
                            <!-- Facts: label and value side by side; the location opens the folder with the item selected. -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding PreviewFacts}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="PreviewFact">
                                        <Grid ColumnDefinitions="96,*" ColumnSpacing="8">
                                            <Label Text="{Binding Label}" FontSize="12" Opacity="0.6" />
                                            <Label Grid.Column="1" Text="{Binding Value}" FontSize="12" LineBreakMode="WordWrap" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" IsVisible="{Binding HasPreviewLocation}" Margin="0,-6,0,0">
                                <Label Text="{String Preview.Label.Location}" FontSize="12" Opacity="0.6" />
                                <Label Grid.Column="1" Text="{Binding PreviewLocation}" FontSize="12" LineBreakMode="HeadTruncation" TextColor="{AppThemeBinding Light=#2F6FEB, Dark=#7FA6F5}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ShowPreviewLocationCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                            <!-- Quick actions. -->
                            <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="6" Margin="0,4,0,0">
                                <Border Style="{StaticResource PreviewAction}">
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding PreviewShareCommand}" /></Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="2">
                                        <ImageButton Style="{StaticResource CommandIcon}" SvgImageSource.Svg="Share.svg" InputTransparent="True" HorizontalOptions="Center" />
                                        <Label Text="{String Preview.Share}" Style="{StaticResource PreviewActionLabel}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource PreviewAction}">
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding PreviewCopyPathCommand}" /></Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="2">
                                        <ImageButton Style="{StaticResource CommandIcon}" SvgImageSource.Svg="Copy.svg" InputTransparent="True" HorizontalOptions="Center" />
                                        <Label Text="{String Preview.CopyPath}" Style="{StaticResource PreviewActionLabel}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource PreviewAction}">
                                    <VerticalStackLayout Spacing="2">
                                        <ImageButton Style="{StaticResource CommandIcon}" SvgImageSource.Svg="Phone.svg" HorizontalOptions="Center" MenuButton.Items="{Binding PreviewSendTo}"
                                                     SemanticProperties.Description="{String Preview.SendTo}" />
                                        <Label Text="{String Preview.SendTo}" Style="{StaticResource PreviewActionLabel}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="3" Style="{StaticResource PreviewAction}" Padding="6,8">
                                    <ImageButton Style="{StaticResource CommandIcon}" SvgImageSource.Svg="More.svg" VerticalOptions="Center" MenuButton.Items="{Binding PreviewMore}"
                                                 SemanticProperties.Description="{String Preview.More}" ToolTipProperties.Text="{String Preview.More}" />
                                </Border>
                            </Grid>
                            <Border IsVisible="{Binding HasPreviewText}" Padding="10" StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#26272A}">
                                <Label Text="{Binding PreviewText}" FontFamily="{OnPlatform MacCatalyst=Menlo, iOS=Menlo, WinUI=Consolas, Android=monospace}" FontSize="11" LineBreakMode="CharacterWrap" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </ScrollView>
            <!-- Home: the disks with how full they are, the linked devices and the folders opened lately. -->
            <ScrollView Grid.Row="2" Grid.RowSpan="2" IsVisible="{Binding IsHome}">
                <VerticalStackLayout Padding="28,12,28,28">
                    <Label Text="{String Home.Title}" FontSize="26" FontAttributes="Bold" />
                    <Label Text="{String Home.Subtitle}" FontSize="13" Opacity="0.6" />

                    <Label Style="{StaticResource HomeSection}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{String Home.ThisDevice}" />
                                <Span Text="  ·  " FontAttributes="None" />
                                <Span Text="{Binding HomeDevice}" FontAttributes="None" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Disks}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="DiskRow">
                                <Border Style="{StaticResource HomeCard}" WidthRequest="270">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenDiskCommand, Source={RelativeSource AncestorType={x:Type ExplorerPageViewModel}}}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Image Source="{Binding Icon}" WidthRequest="36" HeightRequest="36" />
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Kind}" FontSize="12" Opacity="0.6" />
                                            </VerticalStackLayout>
                                        </Grid>
                                        <ProgressBar Progress="{Binding Fraction}" ProgressColor="{AppThemeBinding Light=#2F6FEB, Dark=#5B8DEF}">
                                            <ProgressBar.Triggers>
                                                <DataTrigger TargetType="ProgressBar" Binding="{Binding IsNearlyFull}" Value="True">
                                                    <Setter Property="ProgressColor" Value="{AppThemeBinding Light=#D93025, Dark=#F28B82}" />
                                                </DataTrigger>
                                            </ProgressBar.Triggers>
                                        </ProgressBar>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Free}" FontSize="12" />
                                            <Label Grid.Column="1" Text="{Binding Used}" FontSize="12" Opacity="0.6" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <!-- Without a sidebar (a phone) This Device's places are here: Documents holds what other devices send. -->
                    <VerticalStackLayout IsVisible="{Binding ShowsSidebar, Converter={StaticResource Not}}" Margin="-8,0,0,12">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Places}" BindableLayout.ItemTemplate="{StaticResource PlaceTemplate}" />
                        <!-- Settings live at the foot of the sidebar; without one they come after the places. -->
                        <Border Padding="8,0" Margin="8,1" HeightRequest="{DynamicResource SidebarItemHeight}" StrokeThickness="0" BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowSettingsCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <ImageButton Style="{StaticResource SidebarGlyph}" SvgImageSource.Svg="Settings.svg" />
                                <Label Grid.Column="1" Text="{String Settings.Title}" FontSize="{DynamicResource SidebarFontSize}" VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Border Style="{StaticResource HomeCard}" WidthRequest="270" HorizontalOptions="Start">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenTrashCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <ImageButton Style="{StaticResource SidebarGlyph}" SvgImageSource.Svg="Delete.svg" WidthRequest="40" HeightRequest="40" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding TrashName}" FontSize="14" FontAttributes="Bold" />
                                    <Label Text="{Binding TrashSummary}" FontSize="12" Opacity="0.6" />
                                </VerticalStackLayout>
                            </Grid>
                            <ProgressBar Progress="{Binding TrashProgress}" IsVisible="{Binding IsEmptyingTrash}" />
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="{String Trash.EmptyButton}" Command="{Binding EmptyTrashCommand}" IsEnabled="{Binding CanEmptyTrash}" FontSize="12" Padding="12,0" HeightRequest="28" CornerRadius="14"
                                        BackgroundColor="{AppThemeBinding Light=#FCE8E6, Dark=#4A2522}" TextColor="{AppThemeBinding Light=#C5221F, Dark=#F28B82}" />
                                <Button Text="{String Trash.OpenSettings}" Command="{Binding OpenFullDiskAccessCommand}" IsVisible="{Binding TrashNeedsAccess}" FontSize="12" Padding="12,0" HeightRequest="28" CornerRadius="14"
                                        BackgroundColor="{AppThemeBinding Light=#E4ECFD, Dark=#25324D}" TextColor="{AppThemeBinding Light=#2F6FEB, Dark=#9BB9F7}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{String Devices.Title}" Style="{StaticResource HomeSection}" />
                    <Label Text="{String Home.NoDevices}" FontSize="13" Opacity="0.6" IsVisible="{Binding HasNoDevices}" Margin="0,0,0,8" />
                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Devices}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="DeviceRow">
                                <Border Style="{StaticResource HomeCard}" WidthRequest="220"
                                        ContextMenu.Items="{Binding Menu}" ContextMenu.CommandParameter="{Binding .}">
                                    <Border.GestureRecognizers>
                                        <DropGestureRecognizer DragOver="OnFileDragOver" DragLeave="OnFileDragLeave" Drop="OnFileDrop" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                                        <Grid VerticalOptions="Center">
                                            <ImageButton Style="{StaticResource SidebarGlyph}" SvgImageSource.Svg="{Binding Glyph}" WidthRequest="34" HeightRequest="34" />
                                            <BoxView Style="{StaticResource StatusDot}" WidthRequest="10" HeightRequest="10" CornerRadius="5">
                                                <BoxView.Triggers>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding IsOnline}" Value="True"><Setter Property="Color" Value="#34C759" /></DataTrigger>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding IsOffline}" Value="True"><Setter Property="Color" Value="#A0A5AD" /></DataTrigger>
                                                </BoxView.Triggers>
                                            </BoxView>
                                        </Grid>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding StatusLine}" FontSize="12" Opacity="0.6" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Progress="{Binding Progress, TargetNullValue=0}" IsVisible="{Binding IsTransferring}" Margin="0,8,0,0"
                                                     ProgressColor="{AppThemeBinding Light=#2F6FEB, Dark=#7FA6F5}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <Button Text="{String Devices.Link}" Command="{Binding LinkDeviceCommand}" FontSize="12" Padding="12,0" HeightRequest="28" CornerRadius="14" HorizontalOptions="Start"
                            BackgroundColor="{AppThemeBinding Light=#E4ECFD, Dark=#25324D}" TextColor="{AppThemeBinding Light=#2F6FEB, Dark=#9BB9F7}" />

                    <Label Text="{String Home.Recent}" Style="{StaticResource HomeSection}" />
                    <Label Text="{String Home.NoRecent}" FontSize="13" Opacity="0.6" IsVisible="{Binding HasNoRecent}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentRows}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="RecentRow">
                                <Border Padding="8,6" StrokeThickness="0" StrokeShape="RoundRectangle 6" BackgroundColor="Transparent">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenLocationCommand, Source={RelativeSource AncestorType={x:Type ExplorerPageViewModel}}}" CommandParameter="{Binding Location}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Image Source="folder.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1">
                                            <Label Text="{Binding Name}" FontSize="13" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Path}" FontSize="11" Opacity="0.55" LineBreakMode="MiddleTruncation" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding When}" FontSize="12" Opacity="0.6" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <!-- The preview's left edge resizes it. -->
            <Grid Grid.Row="2" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource Grip}" HorizontalOptions="Start" Margin="-4,0,0,0" IsVisible="{Binding ShowsPreview}" ClassId="PreviewWidth">
                <Grid.GestureRecognizers><PanGestureRecognizer PanUpdated="OnGripPanned" /><PointerGestureRecognizer PointerEntered="OnGripEntered" PointerMoved="OnGripEntered" PointerExited="OnGripExited" /></Grid.GestureRecognizers>
                <BoxView Style="{StaticResource GripLine}" Margin="0" />
            </Grid>

            <!-- Operations the app found unfinished at start, waiting to be resumed. -->
            <Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Padding="16,4" IsVisible="{Binding ShowsInterrupted}"
                  BackgroundColor="{AppThemeBinding Light=#FFF4E5, Dark=#3A2C14}">
                <Label Text="{Binding InterruptedText}" FontSize="12" VerticalTextAlignment="Center" />
                <Button Grid.Column="1" Text="{String Operations.Open}" Command="{Binding ShowOperationsCommand}" FontSize="12" Padding="8,0" HeightRequest="24" />
            </Grid>

            <!-- The running copy or move; a click opens the Operation Center. -->
            <Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="16,4" IsVisible="{Binding ShowsOperation}"
                  BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#1E1F22}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShowOperationsCommand}" />
                </Grid.GestureRecognizers>
                <ProgressBar Progress="{Binding OperationProgress}" WidthRequest="160" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding OperationText}" FontSize="12" LineBreakMode="MiddleTruncation" VerticalTextAlignment="Center" />
                <Button Grid.Column="2" Text="{String Operation.Cancel}" Command="{Binding CancelOperationCommand}" FontSize="12" Padding="8,0" HeightRequest="24" />
            </Grid>
        </Grid>

        <!-- Dual Pane: a splitter to drag, and the second pane (an explorer of its own, without a sidebar). -->
        <!-- The same grip as the sidebar's edge: a hairline between the panes, an 8-point strip to drag. -->
        <Grid x:Name="Splitter" Grid.Column="2" Style="{StaticResource Grip}" Margin="-4,0" ZIndex="1" IsVisible="{Binding IsSplit}">
            <Grid.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnSplitterPanned" />
                <PointerGestureRecognizer PointerEntered="OnGripEntered" PointerMoved="OnGripEntered" PointerExited="OnGripExited" />
            </Grid.GestureRecognizers>
            <BoxView Style="{StaticResource GripLine}" Margin="0" />
        </Grid>
        <ContentView x:Name="SecondPane" Grid.Column="3" IsVisible="{Binding IsSplit}" />
    </Grid>

</SpinePage>
