<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(MauiTargetFrameworks)</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>Spine.FileManager</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>Spine File Manager</ApplicationTitle>
		<ApplicationId>se.cosmomedia.filemanager</ApplicationId>
		<ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<CodesignEntitlements Condition="'$(MacAppStore)' != 'true'">Platforms\MacCatalyst\Entitlements.plist</CodesignEntitlements>
		<CodesignEntitlements Condition="'$(MacAppStore)' == 'true'">Platforms\MacCatalyst\Entitlements.AppStore.plist</CodesignEntitlements>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2F6FEB" />
		<MauiImage Include="Resources\Images\*.svg" BaseSize="32,32" />
		<!-- Menus (MenuAction.Svg) draw their icons from embedded SVGs. -->
		<EmbeddedResource Include="Resources\Images\folder.svg" />
		<!-- The tray icon, drawn at runtime by Spine from an embedded SVG. -->
		<EmbeddedResource Include="Resources\Tray\tray.svg" />
		<!-- Glyphs Spine's set lacks, drawn in its style (50×50, 2-point stroke in currentColor). -->
		<EmbeddedResource Include="Resources\Glyphs\*.svg" />
		<!-- Icons in menus also come from Spine's set (Star, Edit, Copy, Trashcan, Unpin). -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2F6FEB" BaseSize="128,128" />
		<!-- English is the neutral document, Swedish strings.sv.xml (ISpineStrings). WithCulture="false" keeps the
		     .sv. files out of a satellite assembly, where Spine does not look. -->
		<EmbeddedResource Include="Resources\Strings\*.xml" WithCulture="false" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Platforms\MacCatalyst\Entitlements*.plist" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
		<PackageReference Include="Plugin.Maui.Spine" />
		<PackageReference Include="Plugin.Maui.Spine.Svg.Icons" />
		<PackageReference Include="Plugin.Maui.Spine.Barcodes" />
		<PackageReference Include="Plugin.Maui.Spine.Scanner" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Spine.FileManager.Core\Spine.FileManager.Core.csproj" />
	</ItemGroup>

	<!-- Spine pages: the ViewModel half of each page is compiled through its DependentUpon entry below. -->
	<ItemGroup>
		<Compile Remove="**\*.ViewModel.cs" />
	</ItemGroup>

	<ItemGroup>
		<MauiXaml Update="Pages\ExplorerPage.View.xaml">
			<Generator>MSBuild:Compile</Generator>
			<DependentUpon>ExplorerPage.cs</DependentUpon>
		</MauiXaml>
		<Compile Include="Pages\ExplorerPage.ViewModel.cs">
			<DependentUpon>ExplorerPage.cs</DependentUpon>
		</Compile>
		<MauiXaml Update="Pages\OperationsPage.View.xaml">
			<Generator>MSBuild:Compile</Generator>
			<DependentUpon>OperationsPage.cs</DependentUpon>
		</MauiXaml>
		<Compile Include="Pages\OperationsPage.ViewModel.cs">
			<DependentUpon>OperationsPage.cs</DependentUpon>
		</Compile>
		<MauiXaml Update="Pages\FirstRunPage.View.xaml">
			<Generator>MSBuild:Compile</Generator>
			<DependentUpon>FirstRunPage.cs</DependentUpon>
		</MauiXaml>
		<Compile Include="Pages\FirstRunPage.ViewModel.cs">
			<DependentUpon>FirstRunPage.cs</DependentUpon>
		</Compile>
		<MauiXaml Update="Pages\SettingsPage.View.xaml">
			<Generator>MSBuild:Compile</Generator>
			<DependentUpon>SettingsPage.cs</DependentUpon>
		</MauiXaml>
		<Compile Include="Pages\SettingsPage.ViewModel.cs">
			<DependentUpon>SettingsPage.cs</DependentUpon>
		</Compile>
		<MauiXaml Update="Pages\LinkDevicePage.View.xaml">
			<Generator>MSBuild:Compile</Generator>
			<DependentUpon>LinkDevicePage.cs</DependentUpon>
		</MauiXaml>
		<Compile Include="Pages\LinkDevicePage.ViewModel.cs">
			<DependentUpon>LinkDevicePage.cs</DependentUpon>
		</Compile>
	</ItemGroup>

</Project>
